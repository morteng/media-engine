{# Navigation Sidebar Component #}
<nav class="nav-sidebar" aria-label="Documentation navigation">
    {% for section in sections %}
    <div class="nav-section">
        {% if section.title %}
        <h3 class="nav-section-title">{{ section.title }}</h3>
        {% endif %}
        
        <ul>
            {% for item in section.items %}
            <li>
                <a href="{{ item.url }}"{% if item.active %} class="active"{% endif %}>
                    {% if item.icon %}<span class="nav-icon">{{ item.icon }}</span>{% endif %}
                    <span class="nav-label">{{ item.label }}</span>
                    {% if item.badge %}<span class="nav-badge">{{ item.badge }}</span>{% endif %}
                </a>
                
                {% if item.children %}
                <ul class="nav-children">
                    {% for child in item.children %}
                    <li>
                        <a href="{{ child.url }}"{% if child.active %} class="active"{% endif %}>
                            {{ child.label }}
                        </a>
                    </li>
                    {% endfor %}
                </ul>
                {% endif %}
            </li>
            {% endfor %}
        </ul>
    </div>
    {% endfor %}
</nav>

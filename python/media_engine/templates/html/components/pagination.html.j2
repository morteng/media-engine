{# Pagination Component #}
<nav class="pagination" aria-label="Pagination">
    {% if prev_page %}
    <a href="{{ prev_page.url }}" class="pagination-prev" rel="prev">
        <span class="pagination-arrow">←</span>
        <span class="pagination-label">Previous</span>
        <span class="pagination-title">{{ prev_page.title }}</span>
    </a>
    {% else %}
    <span class="pagination-prev disabled"></span>
    {% endif %}
    
    {% if next_page %}
    <a href="{{ next_page.url }}" class="pagination-next" rel="next">
        <span class="pagination-label">Next</span>
        <span class="pagination-arrow">→</span>
        <span class="pagination-title">{{ next_page.title }}</span>
    </a>
    {% else %}
    <span class="pagination-next disabled"></span>
    {% endif %}
</nav>

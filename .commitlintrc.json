{
  "extends": ["@commitlint/config-conventional"],
  "rules": {
    "type-enum": [
      2,
      "always",
      [
        "feat",
        "fix",
        "docs",
        "style",
        "refactor",
        "perf",
        "test",
        "build",
        "ci",
        "chore",
        "revert"
      ]
    ],
    "scope-enum": [
      1,
      "always",
      [
        "core",
        "cms",
        "video",
        "diagrams",
        "builders",
        "mcp",
        "web",
        "cli",
        "dashboard",
        "e2e",
        "deps",
        "ci",
        "ai",
        "publications",
        "relationships",
        "quality",
        "security"
      ]
    ],
    "subject-case": [2, "always", "lower-case"],
    "header-max-length": [2, "always", 100]
  }
}
